# ---------- dependencies ----------
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# ---------- Expo & build outputs ----------
.expo/
dist/
web-build/
expo-env.d.ts

# Prebuild / generated native folders
/ios
/android

# Native builds & signing
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro bundler
.metro-health-check*

# ---------- Debug & logs ----------
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug*
*.log

# ---------- macOS / OS artifacts ----------
.DS_Store
*.pem
Thumbs.db

# ---------- Environment files ----------
.env
.env*.local

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Testing / coverage ----------
coverage/
*.lcov

# ---------- Package manager locks (optional; choose ONE) ----------
# Uncomment only if you actively use one of these alternates to npm:
# yarn.lock
# pnpm-lock.yaml

# ---------- IDE / editor (keep shared configs!) ----------
# .vscode/*                        # uncomment if you want personal-only vscode settings
# !.vscode/extensions.json         # keep shared recommended extensions
# !.vscode/settings.json           # keep shared workspace settings
.idea/
*.swp
*.swo
